{
  "name": "cafeslux-api",
  "version": "13.0.0",
  "description": "Café LUX — Backend (rebuilt)",
  "main": "server.js",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "npx prisma db push --accept-data-loss --skip-generate && node prisma/seed.js && node server.js",
    "dev": "nodemon server.js",
    "build": "npx prisma generate",
    "migrate": "npx prisma migrate deploy",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "prisma": "^5.13.0",
    "nodemon": "^3.1.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
