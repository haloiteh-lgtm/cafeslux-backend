generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH / STAFF
// ─────────────────────────────────────────────
enum EmployeeRole {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  STAFF
}

model Employee {
  id              String           @id @default(cuid())
  name            String
  pin             String
  role            EmployeeRole     @default(STAFF)
  phone           String?
  active          Boolean          @default(true)
  salary          Float?           @default(0)
  createdAt       DateTime         @default(now())

  attendances     Attendance[]
  payrollEntries  PayrollEntry[]
  advanceRequests AdvanceRequest[]
  orders          Order[]
}

model Attendance {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  clockIn    DateTime @default(now())
  clockOut   DateTime?
}

model PayrollEntry {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  amount     Float
  note       String?
  paid       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REFUSED
}

model AdvanceRequest {
  id          String        @id @default(cuid())
  employee    Employee      @relation(fields: [employeeId], references: [id])
  employeeId  String
  amount      Float
  reason      String?
  status      AdvanceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?
}

// ─────────────────────────────────────────────
// MENU
// ─────────────────────────────────────────────
model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  position  Int       @default(0)
  active    Boolean   @default(true)

  products  Product[]
}

model Product {
  id          String    @id @default(cuid())
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  price       Float

  // Ancien système d'offre conservé pour compatibilité
  offerPrice  Float?

  imageUrl    String?
  isSignature Boolean   @default(false)
  active      Boolean   @default(true)
  points      Int       @default(0)
  stockQty    Float?

  orderItems  OrderItem[]

  // Nouveau système : un produit peut appartenir
  // à plusieurs offres
  offerItems  OfferProduct[]
}

// ─────────────────────────────────────────────
// OFFERS
// ─────────────────────────────────────────────

model Offer {
  id              String         @id @default(cuid())
  name            String
  description     String?

  // Exemple : 20 = réduction de 20%
  discountPercent Float?

  // Réduction fixe en MAD si nécessaire
  discountAmount  Float?

  active          Boolean        @default(true)

  startsAt        DateTime?
  endsAt          DateTime?

  products        OfferProduct[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OfferProduct {
  id        String   @id @default(cuid())

  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId   String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Quantité du produit dans l'offre
  quantity  Int      @default(1)

  createdAt DateTime @default(now())

  @@unique([offerId, productId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────
enum OrderStatus {
  PENDING
  APPROVED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  menu
  pos
  gateway
  reservations
}

model Order {
  id            String       @id @default(cuid())
  source        OrderSource  @default(menu)
  status        OrderStatus  @default(PENDING)

  customer      Customer?    @relation(fields: [customerId], references: [id])
  customerId    String?

  customerName  String?
  customerPhone String?

  items         OrderItem[]

  total         Float

  payMethod     String?

  employee      Employee?    @relation(fields: [employeeId], references: [id])
  employeeId    String?

  pointsEarned  Int          @default(0)
  giftCardUsed  String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id        String    @id @default(cuid())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String

  product   Product?  @relation(fields: [productId], references: [id])
  productId String?

  name      String
  price     Float
  qty       Int       @default(1)
}

// ─────────────────────────────────────────────
// CUSTOMERS / LOYALTY
// ─────────────────────────────────────────────
model Customer {
  id           String     @id @default(cuid())
  name         String?
  phone        String     @unique
  email        String?
  passwordHash String?
  pointsTotal  Int        @default(0)
  pointsUsed   Int        @default(0)
  createdAt    DateTime   @default(now())

  orders       Order[]
  giftCards    GiftCard[]
  reviews      Review[]
}

// ─────────────────────────────────────────────
// GIFT CARDS
// ─────────────────────────────────────────────
enum GiftCardStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REJECTED
}

model GiftCard {
  id            String         @id @default(cuid())
  code          String?        @unique
  amount        Float
  balance       Float
  singleUse     Boolean        @default(true)

  status        GiftCardStatus @default(ACTIVE)

  buyerName     String?
  buyerPhone    String?
  recipientName String?
  message       String?

  paymentMethod String?        @default("cash")

  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerId    String?

  createdAt     DateTime       @default(now())
  usedAt        DateTime?

  decidedAt     DateTime?
  decidedBy     String?
}

// ─────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id        String            @id @default(cuid())
  name      String
  phone     String
  date      String
  time      String
  guests    Int               @default(2)
  status    ReservationStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now())
}

// ─────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────
model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  category  String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────
model Review {
  id         String    @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  name       String?
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────
// GAMING ZONE
// ─────────────────────────────────────────────
enum StationType {
  SNOOKER
  BILLARD
  PS5
  PS4
}

enum StationStatus {
  IDLE
  ACTIVE
}

model GamingStation {
  id        String          @id @default(cuid())
  label     String
  type      StationType
  status    StationStatus   @default(IDLE)

  sessions  GamingSession[]

  createdAt DateTime        @default(now())
}

enum GamingSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model GamingSession {
  id            String              @id @default(cuid())

  station       GamingStation       @relation(fields: [stationId], references: [id])
  stationId     String

  playerName    String?
  planLabel     String?

  totalPrice    Float
  paymentMethod String?
  paymentStatus String              @default("pending")

  status        GamingSessionStatus @default(ACTIVE)

  startedAt     DateTime            @default(now())
  endsAt        DateTime?
  endedAt       DateTime?

  createdAt     DateTime            @default(now())
}
