generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH / STAFF
// ─────────────────────────────────────────────
enum EmployeeRole {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  STAFF
}

model Employee {
  id            String    @id @default(cuid())
  name          String
  pin           String    // hashed 4-6 digit PIN
  role          EmployeeRole @default(STAFF)
  phone         String?
  active        Boolean   @default(true)
  salary        Float?    @default(0)
  createdAt     DateTime  @default(now())

  attendances   Attendance[]
  payrollEntries PayrollEntry[]
  advanceRequests AdvanceRequest[]
  orders        Order[]
}

model Attendance {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  clockIn     DateTime  @default(now())
  clockOut    DateTime?
}

model PayrollEntry {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  amount      Float
  note        String?
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REFUSED
}

model AdvanceRequest {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  amount      Float
  reason      String?
  status      AdvanceStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
}

// ─────────────────────────────────────────────
// MENU
// ─────────────────────────────────────────────
model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
}

model Product {
  id          String    @id @default(cuid())
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  price       Float
  imageUrl    String?
  isSignature Boolean   @default(false)
  active      Boolean   @default(true)
  points      Int       @default(0)   // loyalty points earned per unit sold
  stockQty    Float?    // null = untracked
  orderItems  OrderItem[]
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────
enum OrderStatus {
  PENDING     // Les Nouvelles — waiting for Confirmer
  APPROVED    // moved after Confirmer, ticket printed
  PREPARING   // KDS in progress
  READY
  COMPLETED   // removed from active lists
  CANCELLED
}

enum OrderSource {
  menu
  pos
  gateway
  reservations
}

model Order {
  id            String      @id @default(cuid())
  source        OrderSource @default(menu)
  status        OrderStatus @default(PENDING)
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerId    String?
  customerName  String?
  customerPhone String?
  items         OrderItem[]
  total         Float
  payMethod     String?
  employee      Employee?   @relation(fields: [employeeId], references: [id])
  employeeId    String?
  pointsEarned  Int         @default(0)
  giftCardUsed  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  name      String
  price     Float
  qty       Int      @default(1)
}

// ─────────────────────────────────────────────
// CUSTOMERS / LOYALTY
// ─────────────────────────────────────────────
model Customer {
  id            String    @id @default(cuid())
  name          String?
  phone         String    @unique
  email         String?
  passwordHash  String?
  pointsTotal   Int       @default(0)  // lifetime earned
  pointsUsed    Int       @default(0)
  createdAt     DateTime  @default(now())
  orders        Order[]
  giftCards     GiftCard[]
  reviews       Review[]
}

// ─────────────────────────────────────────────
// GIFT CARDS
// ─────────────────────────────────────────────
enum GiftCardStatus {
  ACTIVE
  USED
  EXPIRED
}

model GiftCard {
  id          String    @id @default(cuid())
  code        String    @unique
  amount      Float
  balance     Float
  singleUse   Boolean   @default(true)
  status      GiftCardStatus @default(ACTIVE)
  buyerName   String?
  buyerPhone  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  String?
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
}

// ─────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id        String   @id @default(cuid())
  name      String
  phone     String
  date      String
  time      String
  guests    Int      @default(2)
  status    ReservationStatus @default(PENDING)
  note      String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// EXPENSES (المصاريف — for Tableau de Bord)
// ─────────────────────────────────────────────
model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  category  String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  name       String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}
